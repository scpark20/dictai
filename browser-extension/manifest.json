{
  "manifest_version": 3,
  "name": "DictAI for YouTube",
  "version": "2.2.0",
  "description": "Practice YouTube captions inside YouTube. Captions and progress stay in your browser.",
  "minimum_chrome_version": "106",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Show or hide DictAI"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["po-token-hook.js"], "run_at": "document_start", "world": "MAIN"
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["youtube-content.js"], "css": ["youtube-content.css"], "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["panel.html", "panel.css", "panel.js"],
    "matches": ["https://www.youtube.com/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://192.168.0.68:8771 https://192.168.0.68:8775 http://127.0.0.1:8771 http://localhost:8771"
  }
}
